# Copy to .env and fill in. Never commit .env.
#
# ── Database ─────────────────────────────────────────────────────────────────
# Use a DEVELOPMENT database here, not production. A free Supabase project is
# enough: create one, then `ALLOW_PRODUCTION_DB=` stays unset and nothing you
# run locally can touch the live site. Scripts that write refuse to run
# against the production project unless ALLOW_PRODUCTION_DB=1 is set
# (scripts/db/guard.ts).
#
# Pooled connection (port 6543) for the app; direct (5432) for Prisma CLI.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 32
NEXTAUTH_SECRET=""
AUTH_SECRET=""
CSRF_SECRET=""
# The site's origin. Production: https://ged-nn.com (the apex — see OAuth notes).
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com → Credentials). The redirect URI is
# <NEXTAUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="GED Prep <noreply@example.com>"

# ── Rate limiting (Upstash Redis) ────────────────────────────────────────────
# Without these, rate limits are skipped with a warning. Required in
# production: login, OTP and plan generation rely on them.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Set to false locally to silence the warning when Upstash isn't configured.
# RATE_LIMIT_ENABLED=false

# ── Curriculum import (scripts only) ─────────────────────────────────────────
# YouTube Data API v3 key, used by scripts/import-curriculum.ts to verify clips.
YOUTUBE_API_KEY=""

# ── Optional ─────────────────────────────────────────────────────────────────
# Share of a video that counts as watched (default 0.8). Lower it locally to
# test the completion gate without sitting through clips.
# RESOURCE_COMPLETION_THRESHOLD=0.8
# PRISMA_LOG_QUERIES=true
