generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── USER GROUP ────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String? // nullable: OAuth users may not provide a display name
  image        String? // OAuth profile picture URL (required by NextAuth adapter)
  passwordHash String? // null for OAuth-only accounts (no password set)
  dateOfBirth  DateTime? // null for OAuth-created accounts (skips onboarding DOB)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // NextAuth adapter requires DateTime? (null = unverified, a date = verified at that timestamp).
  // Our custom verify-email route sets this to new Date() on confirmation.
  // OAuth providers set this automatically via the adapter when the provider guarantees email ownership.
  emailVerified            DateTime?
  emailVerificationToken   String? // SHA-256(rawToken) — query by this field to look up a verification attempt
  emailVerificationExpires DateTime? // 24 h from when the token was issued; drives cooldown logic too

  // Password reset — same hashing strategy as email verification.
  // Token expires in 1 h (shorter window than email verification — password resets are higher risk).
  // Both fields are cleared after a successful reset.
  passwordResetToken   String? // SHA-256(rawToken)
  passwordResetExpires DateTime?

  accounts             Account[]
  preferences          UserPreferences?
  proficiencies        UserSubtopicProficiency[]
  assessmentAttempts   UserAssessmentAttempt[]
  questionResponses    UserQuestionResponse[]
  studyPlans           StudyPlan[]
  weeklyAvailabilities WeeklyAvailability[]
  auditLogs            AuditLog[]
  Session              Session[]

  @@index([email])
  @@index([emailVerificationToken])
  @@index([passwordResetToken])
}

// ─── NEXTAUTH MODELS ───────────────────────────────────────────────────────────
// These three models are required by the @auth/prisma-adapter contract.
// Account: stores OAuth provider tokens; one user can link multiple providers.
// Session: required by the adapter interface even when using JWT session strategy.
// VerificationToken: used by Auth.js email magic-link provider (not our custom flow).

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserPreferences {
  id             String   @id @default(cuid())
  userId         String   @unique
  targetExamDate DateTime
  targetScore    Int      @default(145)
  studyGoal      String   @default("PASS") // PASS | COLLEGE_READY | COLLEGE_READY_CREDIT
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSubtopicProficiency {
  id           String   @id @default(cuid())
  userId       String
  subtopicId   String
  score        Float    @default(0) // 0–100
  attemptCount Int      @default(0)
  lastUpdated  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtopic Subtopic @relation(fields: [subtopicId], references: [id])

  @@unique([userId, subtopicId])
  @@index([userId])
}

// ─── CURRICULUM GROUP ──────────────────────────────────────────────────────────

model Subject {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String   @unique // MATH | RLA | SS | SCI
  passingScore Int      @default(145)
  maxScore     Int      @default(200)
  createdAt    DateTime @default(now())

  categories  Category[]
  assessments Assessment[]
}

model Category {
  id        String   @id @default(cuid())
  subjectId String
  name      String
  weight    Float // percentage weight in subject exam
  createdAt DateTime @default(now())

  subject Subject @relation(fields: [subjectId], references: [id])
  topics  Topic[]
}

model Topic {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  description String?
  createdAt   DateTime @default(now())

  category  Category   @relation(fields: [categoryId], references: [id])
  subtopics Subtopic[]
}

model Subtopic {
  id               String   @id @default(cuid())
  topicId          String
  name             String
  description      String
  learningUrl      String
  estimatedMinutes Int
  difficultyLevel  Int // 1–5
  createdAt        DateTime @default(now())

  topic         Topic                     @relation(fields: [topicId], references: [id])
  proficiencies UserSubtopicProficiency[]
  questions     Question[]
  studySessions StudySession[]
  prerequisites SubtopicPrerequisite[]    @relation("Dependent")
  dependents    SubtopicPrerequisite[]    @relation("Prerequisite")
}

model SubtopicPrerequisite {
  id             String   @id @default(cuid())
  dependentId    String
  prerequisiteId String
  createdAt      DateTime @default(now())

  dependent    Subtopic @relation("Dependent", fields: [dependentId], references: [id], onDelete: Cascade)
  prerequisite Subtopic @relation("Prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([dependentId, prerequisiteId])
  @@index([dependentId])
  @@index([prerequisiteId])
}

// ─── ASSESSMENT GROUP ──────────────────────────────────────────────────────────

model Assessment {
  id         String         @id @default(cuid())
  type       AssessmentType // PRE | QUIZ | MOCK
  subjectId  String?
  subtopicId String?
  title      String
  timeLimit  Int? // minutes, null = unlimited
  createdAt  DateTime       @default(now())

  subject   Subject?                @relation(fields: [subjectId], references: [id])
  questions Question[]
  attempts  UserAssessmentAttempt[]
}

model Question {
  id              String         @id @default(cuid())
  assessmentId    String
  subtopicId      String?
  text            String
  options         Json // [{ id: string, text: string }]
  correctOptionId String
  explanation     String?
  source          QuestionSource @default(AI_GENERATED)
  difficulty      Int            @default(3) // 1–5
  createdAt       DateTime       @default(now())

  assessment Assessment             @relation(fields: [assessmentId], references: [id])
  subtopic   Subtopic?              @relation(fields: [subtopicId], references: [id])
  responses  UserQuestionResponse[]
}

model UserAssessmentAttempt {
  id            String    @id @default(cuid())
  userId        String
  assessmentId  String
  score         Float // 0–100 percentage
  rawScore      Int
  maxScore      Int
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  triggerAction String? // GA action triggered by this attempt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment             @relation(fields: [assessmentId], references: [id])
  responses  UserQuestionResponse[]
}

model UserQuestionResponse {
  id             String   @id @default(cuid())
  userId         String
  attemptId      String
  questionId     String
  selectedOption String
  isCorrect      Boolean
  timeSpent      Int? // seconds
  createdAt      DateTime @default(now())

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt  UserAssessmentAttempt @relation(fields: [attemptId], references: [id])
  question Question              @relation(fields: [questionId], references: [id])
}

// ─── AVAILABILITY GROUP ────────────────────────────────────────────────────────

model WeeklyAvailability {
  id            String   @id @default(cuid())
  userId        String
  weekStartDate DateTime // วันจันทร์ต้นสัปดาห์ที่กำหนด (เป็นแค่วันที่ ไม่ใช่ datetime เต็ม)
  createdAt     DateTime @default(now())

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots      AvailabilitySlot[]
  studyPlans StudyPlan[]        @relation("WeeklyAvailabilityPlans")

  @@unique([userId, weekStartDate])
  @@index([userId, weekStartDate(sort: Desc)])
}

model AvailabilitySlot {
  id                   String   @id @default(cuid())
  weeklyAvailabilityId String
  dayOfWeek            Int // 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  startTime            String // "14:00" — เก็บเป็น text ง่ายสุด ไม่ยุ่ง timezone
  endTime              String // "16:00"
  createdAt            DateTime @default(now())

  weeklyAvailability WeeklyAvailability @relation(fields: [weeklyAvailabilityId], references: [id], onDelete: Cascade)

  @@index([weeklyAvailabilityId, dayOfWeek])
}

// ─── GA ENGINE GROUP ───────────────────────────────────────────────────────────

model StudyPlan {
  id                   String        @id @default(cuid())
  userId               String
  version              Int           @default(1)
  fitnessScore         Float
  triggerReason        TriggerReason
  isActive             Boolean       @default(true)
  generatedAt          DateTime      @default(now())
  metadata             Json? // GA configuration used
  weeklyAvailabilityId String? // availability ที่ใช้ generate รอบนี้

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions           StudySession[]
  gaLogs             GaExecutionLog[]
  weeklyAvailability WeeklyAvailability? @relation("WeeklyAvailabilityPlans", fields: [weeklyAvailabilityId], references: [id])

  @@index([userId, isActive, version(sort: Desc)])
}

model StudySession {
  id            String        @id @default(cuid())
  studyPlanId   String
  subtopicId    String
  scheduledDate DateTime
  durationMins  Int
  order         Int // position in plan sequence
  status        SessionStatus @default(PENDING)
  completedAt   DateTime?
  createdAt     DateTime      @default(now())

  studyPlan StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  subtopic  Subtopic  @relation(fields: [subtopicId], references: [id])

  @@index([studyPlanId, scheduledDate, status])
}

model GaExecutionLog {
  id           String   @id @default(cuid())
  studyPlanId  String
  generation   Int
  bestFitness  Float
  avgFitness   Float
  worstFitness Float
  // breakdown of fitness components per generation
  metadata     Json
  createdAt    DateTime @default(now())

  studyPlan StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)

  @@index([studyPlanId, generation])
}

model RevokedToken {
  id        String   @id @default(cuid())
  tokenJti  String   @unique
  userId    String
  revokedAt DateTime @default(now())
  expiresAt DateTime

  @@index([tokenJti])
}

// ─── AUDIT LOG ─────────────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(cuid())
  // userId is nullable: unauthenticated events (failed login, unknown-email reset)
  // still produce audit records with no user identity.
  // onDelete: SetNull — if a user account is deleted, their logs are KEPT but
  // anonymised by nulling the FK. Audit logs must never be deleted.
  userId     String?
  action     AuditAction
  // entityType + entityId describe what record was affected.
  // e.g. entityType="user", entityId="clxxx" or entityType="preferences", entityId="clyyy"
  entityType String?
  entityId   String?
  // Network context — essential for security monitoring and IP-based threat detection.
  ipAddress  String?
  userAgent  String? // truncated to 500 chars at write time
  // Structured extra context. NEVER contains passwords, tokens, or PII beyond what
  // is already in the other typed columns. Sanitised before insert.
  metadata   Json?
  // Explicit success flag lets you filter "show me all failed logins" without
  // parsing metadata or action names.
  success    Boolean     @default(true)
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Query patterns we must support efficiently:
  //   "Show audit trail for user X"         → userId + createdAt
  //   "Show all failed logins"              → action + createdAt
  //   "Show all activity from IP Y"         → ipAddress + createdAt
  //   "Show recent activity across system"  → createdAt alone
  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([ipAddress, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

// ─── ENUMS ─────────────────────────────────────────────────────────────────────

enum AssessmentType {
  PRE
  QUIZ
  MOCK
}

enum QuestionSource {
  REAL
  AI_GENERATED
}

enum TriggerReason {
  INITIAL
  QUIZ_FAILURE
  MOCK_TEST_LOW
  SCHEDULE_CHANGE
  MANUAL_REQUEST
}

enum SessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum AuditAction {
  // ── Auth ──────────────────────────────────────────────────────────────────
  AUTH_LOGIN_SUCCESS
  AUTH_LOGIN_FAILURE
  AUTH_LOGOUT
  AUTH_REGISTER
  // ── Email verification ────────────────────────────────────────────────────
  AUTH_EMAIL_VERIFIED
  AUTH_EMAIL_VERIFY_FAILED
  // ── Password reset ────────────────────────────────────────────────────────
  AUTH_PASSWORD_RESET_REQUESTED
  AUTH_PASSWORD_RESET_SUCCESS
  AUTH_PASSWORD_RESET_FAILED
  // ── Profile ───────────────────────────────────────────────────────────────
  USER_PREFERENCES_UPDATED
  // ── Learning activity ─────────────────────────────────────────────────────
  ASSESSMENT_SUBMITTED
  STUDY_SESSION_COMPLETED
  STUDY_PLAN_GENERATED
}
