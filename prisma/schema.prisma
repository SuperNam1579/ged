generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USER GROUP ────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  dateOfBirth  DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  preferences        UserPreferences?
  proficiencies      UserSubtopicProficiency[]
  assessmentAttempts UserAssessmentAttempt[]
  questionResponses  UserQuestionResponse[]
  studyPlans         StudyPlan[]

  @@index([email])
}

model UserPreferences {
  id             String   @id @default(cuid())
  userId         String   @unique
  targetExamDate DateTime
  hoursPerDay    Float
  targetScore    Int      @default(145)
  availability   Json // { mon: bool, tue: bool, wed: bool, thu: bool, fri: bool, sat: bool, sun: bool }
  studyGoal      String   @default("PASS") // PASS | COLLEGE_READY | COLLEGE_READY_CREDIT
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSubtopicProficiency {
  id           String   @id @default(cuid())
  userId       String
  subtopicId   String
  score        Float    @default(0) // 0–100
  attemptCount Int      @default(0)
  lastUpdated  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtopic Subtopic @relation(fields: [subtopicId], references: [id])

  @@unique([userId, subtopicId])
  @@index([userId])
}

// ─── CURRICULUM GROUP ──────────────────────────────────────────────────────────

model Subject {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String   @unique // MATH | RLA | SS | SCI
  passingScore Int      @default(145)
  maxScore     Int      @default(200)
  createdAt    DateTime @default(now())

  categories  Category[]
  assessments Assessment[]
}

model Category {
  id        String   @id @default(cuid())
  subjectId String
  name      String
  weight    Float // percentage weight in subject exam
  createdAt DateTime @default(now())

  subject Subject @relation(fields: [subjectId], references: [id])
  topics  Topic[]
}

model Topic {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  description String?
  createdAt   DateTime @default(now())

  category  Category  @relation(fields: [categoryId], references: [id])
  subtopics Subtopic[]
}

model Subtopic {
  id               String   @id @default(cuid())
  topicId          String
  name             String
  description      String
  learningUrl      String
  estimatedMinutes Int
  difficultyLevel  Int // 1–5
  prerequisiteIds  String[] // array of Subtopic IDs
  createdAt        DateTime @default(now())

  topic         Topic                     @relation(fields: [topicId], references: [id])
  proficiencies UserSubtopicProficiency[]
  questions     Question[]
  studySessions StudySession[]
}

// ─── ASSESSMENT GROUP ──────────────────────────────────────────────────────────

model Assessment {
  id         String         @id @default(cuid())
  type       AssessmentType // PRE | QUIZ | MOCK
  subjectId  String?
  subtopicId String?
  title      String
  timeLimit  Int? // minutes, null = unlimited
  createdAt  DateTime       @default(now())

  subject   Subject?                @relation(fields: [subjectId], references: [id])
  questions Question[]
  attempts  UserAssessmentAttempt[]
}

model Question {
  id              String         @id @default(cuid())
  assessmentId    String
  subtopicId      String?
  text            String
  options         Json // [{ id: string, text: string }]
  correctOptionId String
  explanation     String?
  source          QuestionSource @default(AI_GENERATED)
  difficulty      Int            @default(3) // 1–5
  createdAt       DateTime       @default(now())

  assessment Assessment           @relation(fields: [assessmentId], references: [id])
  subtopic   Subtopic?            @relation(fields: [subtopicId], references: [id])
  responses  UserQuestionResponse[]
}

model UserAssessmentAttempt {
  id            String    @id @default(cuid())
  userId        String
  assessmentId  String
  score         Float // 0–100 percentage
  rawScore      Int
  maxScore      Int
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  triggerAction String? // GA action triggered by this attempt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment             @relation(fields: [assessmentId], references: [id])
  responses  UserQuestionResponse[]
}

model UserQuestionResponse {
  id             String   @id @default(cuid())
  userId         String
  attemptId      String
  questionId     String
  selectedOption String
  isCorrect      Boolean
  timeSpent      Int? // seconds
  createdAt      DateTime @default(now())

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt  UserAssessmentAttempt @relation(fields: [attemptId], references: [id])
  question Question              @relation(fields: [questionId], references: [id])
}

// ─── GA ENGINE GROUP ───────────────────────────────────────────────────────────

model StudyPlan {
  id            String        @id @default(cuid())
  userId        String
  version       Int           @default(1)
  fitnessScore  Float
  triggerReason TriggerReason
  isActive      Boolean       @default(true)
  generatedAt   DateTime      @default(now())
  metadata      Json? // GA configuration used

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions StudySession[]
  gaLogs   GaExecutionLog[]

  @@index([userId, isActive, version(sort: Desc)])
}

model StudySession {
  id            String        @id @default(cuid())
  studyPlanId   String
  subtopicId    String
  scheduledDate DateTime
  durationMins  Int
  order         Int // position in plan sequence
  status        SessionStatus @default(PENDING)
  completedAt   DateTime?
  createdAt     DateTime      @default(now())

  studyPlan StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  subtopic  Subtopic  @relation(fields: [subtopicId], references: [id])

  @@index([studyPlanId, scheduledDate, status])
}

model GaExecutionLog {
  id           String   @id @default(cuid())
  studyPlanId  String
  generation   Int
  bestFitness  Float
  avgFitness   Float
  worstFitness Float
  // breakdown of fitness components per generation
  metadata     Json
  createdAt    DateTime @default(now())

  studyPlan StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)

  @@index([studyPlanId, generation])
}

// ─── ENUMS ─────────────────────────────────────────────────────────────────────

enum AssessmentType {
  PRE
  QUIZ
  MOCK
}

enum QuestionSource {
  REAL
  AI_GENERATED
}

enum TriggerReason {
  INITIAL
  QUIZ_FAILURE
  MOCK_TEST_LOW
  SCHEDULE_CHANGE
  MANUAL_REQUEST
}

enum SessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}
