generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── USER GROUP ────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String? // nullable: OAuth users may not provide a display name
  image        String? // OAuth profile picture URL (required by NextAuth adapter)
  passwordHash String? // null for OAuth-only accounts (no password set)
  dateOfBirth  DateTime? // null for OAuth-created accounts (skips onboarding DOB)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // NextAuth adapter requires DateTime? (null = unverified, a date = verified at that timestamp).
  // Our custom verify-email route sets this to new Date() on confirmation.
  // OAuth providers set this automatically via the adapter when the provider guarantees email ownership.
  emailVerified            DateTime?
  emailVerificationToken   String? // SHA-256(rawToken) — query by this field to look up a verification attempt
  emailVerificationExpires DateTime? // 24 h from when the token was issued; drives cooldown logic too

  // Password reset — same hashing strategy as email verification.
  // Token expires in 1 h (shorter window than email verification — password resets are higher risk).
  // Both fields are cleared after a successful reset.
  passwordResetToken   String? // SHA-256(rawToken)
  passwordResetExpires DateTime?

  accounts             Account[]
  preferences          UserPreferences?
  proficiencies        UserSubtopicProficiency[]
  assessmentAttempts   UserAssessmentAttempt[]
  questionResponses    UserQuestionResponse[]
  studyPlans           StudyPlan[]
  weeklyAvailabilities WeeklyAvailability[]
  availabilityTemplate WeeklyAvailabilityTemplate?
  auditLogs            AuditLog[]
  resourceProgress     UserResourceProgress[]

  @@index([email])
  @@index([emailVerificationToken])
  @@index([passwordResetToken])
}

// ─── NEXTAUTH MODELS ───────────────────────────────────────────────────────────
// Account: stores OAuth provider tokens; one user can link multiple providers.
//
// The adapter's Session and VerificationToken models were removed (Sep 2026).
// Auth.js only touches Session under the "database" session strategy — every
// createSession/getSessionAndUser/deleteSession call in @auth/core sits behind
// !useJwtSession — and VerificationToken only for the email magic-link
// provider. This app uses the JWT strategy and its own email verification
// (User.emailVerificationToken), so both tables were empty and unread. Switching
// to database sessions or adding the Email provider means adding them back.

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  targetExamDate       DateTime
  targetScore          Int      @default(145)
  selectedSubjectCodes String[] @default([]) // e.g. ["MATH","SCI"] — chosen in onboarding step 1
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSubtopicProficiency {
  id           String   @id @default(cuid())
  userId       String
  subtopicId   String
  score        Float    @default(0) // 0–100
  attemptCount Int      @default(0)
  lastUpdated  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtopic Subtopic @relation(fields: [subtopicId], references: [id])

  @@unique([userId, subtopicId])
  @@index([userId])
}

// ─── CURRICULUM GROUP ──────────────────────────────────────────────────────────

model Subject {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String   @unique // MATH | RLA | SS | SCI
  passingScore Int      @default(145)
  maxScore     Int      @default(200)
  createdAt    DateTime @default(now())

  categories  Category[]
  assessments Assessment[]
}

model Category {
  id        String   @id @default(cuid())
  subjectId String
  name      String
  weight    Float // percentage weight in subject exam
  createdAt DateTime @default(now())

  subject Subject @relation(fields: [subjectId], references: [id])
  topics  Topic[]

  // Natural key. The seed upserts the curriculum tree on these rather than
  // deleting and recreating it, so that IDs — which learner progress, study
  // plans and the resource table all point at — survive a re-seed.
  @@unique([subjectId, name])
}

model Topic {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  description String?
  createdAt   DateTime @default(now())

  category  Category   @relation(fields: [categoryId], references: [id])
  subtopics Subtopic[]

  @@unique([categoryId, name])
}

model Subtopic {
  id               String   @id @default(cuid())
  topicId          String
  name             String
  description      String
  learningUrl      String
  estimatedMinutes Int
  difficultyLevel  Int // 1–5
  createdAt        DateTime @default(now())

  topic         Topic                     @relation(fields: [topicId], references: [id])
  units         Unit[]
  resources     Resource[]
  proficiencies UserSubtopicProficiency[]
  questions     Question[]
  studySessions StudySession[]
  prerequisites SubtopicPrerequisite[]    @relation("Dependent")
  dependents    SubtopicPrerequisite[]    @relation("Prerequisite")

  @@unique([topicId, name])
}

model SubtopicPrerequisite {
  id             String   @id @default(cuid())
  dependentId    String
  prerequisiteId String
  createdAt      DateTime @default(now())

  dependent    Subtopic @relation("Dependent", fields: [dependentId], references: [id], onDelete: Cascade)
  prerequisite Subtopic @relation("Prerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([dependentId, prerequisiteId])
  @@index([dependentId])
  @@index([prerequisiteId])
}

// ─── ASSESSMENT GROUP ──────────────────────────────────────────────────────────

model Assessment {
  id         String         @id @default(cuid())
  type       AssessmentType // PRE | QUIZ | MOCK
  subjectId  String?
  subtopicId String?
  title      String
  createdAt  DateTime       @default(now())

  subject   Subject?                @relation(fields: [subjectId], references: [id])
  questions Question[]
  attempts  UserAssessmentAttempt[]
}

model Question {
  id              String         @id @default(cuid())
  assessmentId    String
  subtopicId      String?
  text            String
  options         Json // [{ id: string, text: string }]
  correctOptionId String
  explanation     String?
  source          QuestionSource @default(AI_GENERATED)
  difficulty      Int            @default(3) // 1–5
  createdAt       DateTime       @default(now())

  assessment Assessment             @relation(fields: [assessmentId], references: [id])
  subtopic   Subtopic?              @relation(fields: [subtopicId], references: [id])
  responses  UserQuestionResponse[]
}

model UserAssessmentAttempt {
  id           String    @id @default(cuid())
  userId       String
  assessmentId String
  score        Float // 0–100 percentage
  rawScore     Int
  maxScore     Int
  completedAt  DateTime?

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment             @relation(fields: [assessmentId], references: [id])
  responses  UserQuestionResponse[]
}

model UserQuestionResponse {
  id             String   @id @default(cuid())
  userId         String
  attemptId      String
  questionId     String
  selectedOption String
  isCorrect      Boolean
  timeSpent      Int? // seconds
  createdAt      DateTime @default(now())

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt  UserAssessmentAttempt @relation(fields: [attemptId], references: [id])
  question Question              @relation(fields: [questionId], references: [id])
}

// ─── AVAILABILITY GROUP ────────────────────────────────────────────────────────

model WeeklyAvailability {
  id            String   @id @default(cuid())
  userId        String
  weekStartDate DateTime // วันจันทร์ต้นสัปดาห์ที่กำหนด (เป็นแค่วันที่ ไม่ใช่ datetime เต็ม)
  createdAt     DateTime @default(now())

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots      AvailabilitySlot[]
  studyPlans StudyPlan[]        @relation("WeeklyAvailabilityPlans")

  @@unique([userId, weekStartDate])
  @@index([userId, weekStartDate(sort: Desc)])
}

model AvailabilitySlot {
  id                   String   @id @default(cuid())
  weeklyAvailabilityId String
  dayOfWeek            Int // 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  startTime            String // "14:00" — เก็บเป็น text ง่ายสุด ไม่ยุ่ง timezone
  endTime              String // "16:00"
  createdAt            DateTime @default(now())

  weeklyAvailability WeeklyAvailability @relation(fields: [weeklyAvailabilityId], references: [id], onDelete: Cascade)

  @@index([weeklyAvailabilityId, dayOfWeek])
}

// ── Recurring availability ("Availability Calendar") ──────────────────────────
// The user's *usual* weekly free-time pattern. This is NOT a study plan and is
// never fed to the GA directly — it only pre-fills each week's draft. Editing it
// affects future (not-yet-generated) weeks; it does not change past snapshots.
model WeeklyAvailabilityTemplate {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots WeeklyAvailabilityTemplateSlot[]
}

model WeeklyAvailabilityTemplateSlot {
  id         String @id @default(cuid())
  templateId String
  dayOfWeek  Int // 0=Sun..6=Sat
  startTime  String // "HH:MM" — multiple slots per day = multiple rows
  endTime    String

  template WeeklyAvailabilityTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

// ─── GA ENGINE GROUP ───────────────────────────────────────────────────────────

model StudyPlan {
  id                   String        @id @default(cuid())
  userId               String
  version              Int           @default(1)
  fitnessScore         Float
  triggerReason        TriggerReason
  isActive             Boolean       @default(true)
  generatedAt          DateTime      @default(now())
  metadata             Json? // GA configuration used
  weeklyAvailabilityId String? // availability ที่ใช้ generate รอบนี้

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions           StudySession[]
  gaLogs             GaExecutionLog[]
  weeklyAvailability WeeklyAvailability? @relation("WeeklyAvailabilityPlans", fields: [weeklyAvailabilityId], references: [id])

  @@index([userId, isActive, version(sort: Desc)])
}

model StudySession {
  id            String        @id @default(cuid())
  studyPlanId   String
  subtopicId    String
  scheduledDate DateTime
  durationMins  Int
  order         Int // position in plan sequence
  status        SessionStatus @default(PENDING)
  // STUDY learns new content; REVIEW goes back over a subtopic already studied
  // (the days before the exam once the content is done). A REVIEW never counts
  // as covering content, so it never stops a subtopic being planned.
  kind          SessionKind   @default(STUDY)
  completedAt   DateTime?
  createdAt     DateTime      @default(now())

  // A long subtopic is split into several sessions at unit or lesson
  // boundaries, so one session may cover only part of it: "part 2 of 5".
  // Both null means the session covers the whole subtopic — every session
  // created before the split existed, and every subtopic with no videos.
  partIndex Int?
  partCount Int?

  studyPlan StudyPlan              @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  subtopic  Subtopic               @relation(fields: [subtopicId], references: [id])
  resources StudySessionResource[]

  @@index([studyPlanId, scheduledDate, status])
}

// The clips one study session covers. No rows = the whole subtopic (see
// StudySession.partIndex).
//
// Points at Resource rather than at Lesson on purpose: a Resource ID is
// `<subtopicId>-<youtubeId>` and survives re-imports, whereas renaming a unit or
// lesson in the sheet mints a new row — a session tied to a lesson would lose
// its content the next time the curriculum is imported.
model StudySessionResource {
  sessionId  String
  resourceId String

  session  StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  resource Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([sessionId, resourceId])
  @@index([resourceId])
}

// ─── Curriculum structure below the subtopic ─────────────────────────────────
// Subtopic → Unit → Lesson → Resource, from the sheet's "Unit (Khan)" and
// "หัวข้อหลัก (Lesson)" columns. Owned by scripts/import-curriculum.ts.
//
// Units belong to one subtopic even when the same Khan unit feeds two subtopics
// (exponent rules serve both "Exponents & roots" and "Quadratic functions"):
// each subtopic keeps its own copy so their orders never interfere.
//
// The scheduler cuts long subtopics into sessions at unit boundaries first and
// lesson boundaries only when a unit won't fit in a day, so these are the
// seams a session can start and end on. A lesson is never split.
model Unit {
  id         String @id @default(cuid())
  subtopicId String
  name       String
  order      Int

  subtopic Subtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@unique([subtopicId, name])
}

model Lesson {
  id     String @id @default(cuid())
  unitId String
  name   String
  order  Int

  unit      Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  resources Resource[]

  @@unique([unitId, name])
}

// A learning resource attached to a subtopic. Video-only for now.
//
// ── About the ID ──────────────────────────────────────────────────────────
// `id` is not a cuid. It is `<subtopicId>-<youtubeId>`, minted by
// scripts/import-curriculum.ts, and that is a deliberate choice rather than a
// leftover from the fixture this table replaced.
//
// The obvious alternative — numbering clips by their position in the subtopic —
// fails in a way that is silent and therefore dangerous. Insert one clip in the
// middle of a subtopic and every later position shifts by one, so an ID that
// meant clip A now means clip B. Watch progress does not go missing; it moves
// onto the wrong video. Nobody sees an error, and the 80% gate starts letting
// learners past material they never opened.
//
// Deriving the ID from the video itself makes identity follow the content:
// clips can be inserted, reordered or cut and every learner's progress stays
// attached to what they actually watched. Replacing a taken-down video with a
// different upload does start its progress over, which is correct — it is a
// different video.
model Resource {
  id         String @id
  subtopicId String

  // VIDEO plays in our embedded player. ARTICLE is a page on Khan that the
  // learner opens in a new tab: Khan's login and progress don't survive being
  // framed, and copying the text in isn't ours to do.
  kind ResourceKind @default(VIDEO)

  // The 11-character YouTube video ID — not a full URL. Null for articles.
  youtubeId    String?
  // Where an article lives. Null for videos, whose address is derived from
  // youtubeId.
  url          String?
  title        String
  channelTitle String

  // VIDEO: total length in whole seconds. Completion is decided on the server,
  // and the server cannot ask the browser how long a video is without trusting
  // the browser — duration has to be known independently of the player.
  //
  // ARTICLE: plain reading time, wordCount at READING_WPM
  // (src/lib/resources/types.ts). Stored in the same column so the scheduler,
  // which packs sessions by duration, needs no second path for articles.
  durationSec Int

  // Words on the page, counted by hand from Khan. What durationSec is derived
  // from for articles; kept so the reading speed can be changed without
  // re-counting. Null for videos.
  wordCount Int?

  // The Lesson row this clip belongs to (the sheet's "หัวข้อหลัก" column, inside
  // its "Unit (Khan)"). Replaced a plain `lesson` name column, which could not
  // tell apart lessons that share a name across units. Null only for clips from
  // the old search-based importer, which have no curriculum structure.
  lessonId String?

  // Position within the subtopic's list, ascending and contiguous from 0.
  order Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subtopic      Subtopic               @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  lessonRef     Lesson?                @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  progress      UserResourceProgress[]
  studySessions StudySessionResource[]

  @@index([subtopicId])
  @@index([lessonId])
}

// Per-user watch progress against a learning resource.
model UserResourceProgress {
  id         String @id @default(cuid())
  userId     String
  resourceId String

  // Cumulative seconds watched. Monotonic by construction — the route clamps
  // both the direction and the rate at which this may grow, so it cannot be
  // driven forward faster than wall-clock time actually passed.
  watchedSec Int @default(0)

  // Resume point. Unlike watchedSec this may move backwards, because seeking
  // backwards is a legitimate thing for a learner to do.
  lastPosSec Int @default(0)

  completedAt DateTime?

  // Articles only: when the learner first opened the page on Khan. The "read"
  // button is checked against this on the server — time since opening, not a
  // number the browser reports.
  openedAt DateTime?

  createdAt DateTime @default(now())

  // The clamp in the progress route reads this to work out how much wall-clock
  // time elapsed since the previous heartbeat.
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId])
  @@index([resourceId])
}

model GaExecutionLog {
  id           String   @id @default(cuid())
  studyPlanId  String
  generation   Int
  bestFitness  Float
  avgFitness   Float
  worstFitness Float
  // breakdown of fitness components per generation
  metadata     Json
  createdAt    DateTime @default(now())

  studyPlan StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)

  @@index([studyPlanId, generation])
}

model RevokedToken {
  id        String   @id @default(cuid())
  tokenJti  String   @unique
  userId    String
  revokedAt DateTime @default(now())
  expiresAt DateTime

  @@index([tokenJti])
}

// ─── AUDIT LOG ─────────────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(cuid())
  // userId is nullable: unauthenticated events (failed login, unknown-email reset)
  // still produce audit records with no user identity.
  // onDelete: SetNull — if a user account is deleted, their logs are KEPT but
  // anonymised by nulling the FK. Audit logs must never be deleted.
  userId     String?
  action     AuditAction
  // entityType + entityId describe what record was affected.
  // e.g. entityType="user", entityId="clxxx" or entityType="preferences", entityId="clyyy"
  entityType String?
  entityId   String?
  // Network context — essential for security monitoring and IP-based threat detection.
  ipAddress  String?
  userAgent  String? // truncated to 500 chars at write time
  // Structured extra context. NEVER contains passwords, tokens, or PII beyond what
  // is already in the other typed columns. Sanitised before insert.
  metadata   Json?
  // Explicit success flag lets you filter "show me all failed logins" without
  // parsing metadata or action names.
  success    Boolean     @default(true)
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Query patterns we must support efficiently:
  //   "Show audit trail for user X"         → userId + createdAt
  //   "Show all failed logins"              → action + createdAt
  //   "Show all activity from IP Y"         → ipAddress + createdAt
  //   "Show recent activity across system"  → createdAt alone
  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([ipAddress, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

// ─── ENUMS ─────────────────────────────────────────────────────────────────────

enum ResourceKind {
  VIDEO
  ARTICLE
}

enum AssessmentType {
  PRE
  QUIZ
  MOCK
}

enum QuestionSource {
  REAL
  AI_GENERATED
}

enum TriggerReason {
  INITIAL
  QUIZ_FAILURE
  MOCK_TEST_LOW
  SCHEDULE_CHANGE
  MANUAL_REQUEST
}

enum SessionKind {
  STUDY
  REVIEW
}

enum SessionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum AuditAction {
  // ── Auth ──────────────────────────────────────────────────────────────────
  AUTH_LOGIN_SUCCESS
  AUTH_LOGIN_FAILURE
  AUTH_LOGOUT
  AUTH_REGISTER
  // ── Email verification ────────────────────────────────────────────────────
  AUTH_EMAIL_VERIFIED
  AUTH_EMAIL_VERIFY_FAILED
  // ── Password reset ────────────────────────────────────────────────────────
  AUTH_PASSWORD_RESET_REQUESTED
  AUTH_PASSWORD_RESET_SUCCESS
  AUTH_PASSWORD_RESET_FAILED
  // ── Profile ───────────────────────────────────────────────────────────────
  USER_PREFERENCES_UPDATED
  // ── Learning activity ─────────────────────────────────────────────────────
  ASSESSMENT_SUBMITTED
  STUDY_SESSION_COMPLETED
  STUDY_PLAN_GENERATED
}
